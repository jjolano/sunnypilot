+func coordinateMatches(latA float64, lonA float64, latB float64, lonB float64) bool {
+	return latA == latB && lonA == lonB
+}
+
+func distanceToTrafficControl(from Position, way Way, isForward bool, targetLat float64, targetLon float64) (float64, bool) {
+	if DistanceToPoint(from.Latitude*TO_RADIANS, from.Longitude*TO_RADIANS, targetLat*TO_RADIANS, targetLon*TO_RADIANS) < 1.0 {
+		return 0.0, true
+	}
+
+	distanceResult, err := DistanceToWay(from, way)
+	if err != nil {
+		return 0.0, false
+	}
+
+	nodes, err := way.Nodes()
+	if err != nil || nodes.Len() == 0 {
+		return 0.0, false
+	}
+
+	start := distanceResult.LineEnd
+	if !isForward {
+		start = distanceResult.LineStart
+	}
+
+	lat := start.Latitude()
+	lon := start.Longitude()
+	distance := DistanceToPoint(from.Latitude*TO_RADIANS, from.Longitude*TO_RADIANS, lat*TO_RADIANS, lon*TO_RADIANS)
+	started := false
+
+	for i := 0; i < nodes.Len(); i++ {
+		index := i
+		if !isForward {
+			index = nodes.Len() - 1 - i
+		}
+
+		node := nodes.At(index)
+		nLat := node.Latitude()
+		nLon := node.Longitude()
+
+		if !started {
+			if !coordinateMatches(nLat, nLon, lat, lon) {
+				continue
+			}
+			started = true
+		}
+
+		if !coordinateMatches(nLat, nLon, lat, lon) {
+			distance += DistanceToPoint(lat*TO_RADIANS, lon*TO_RADIANS, nLat*TO_RADIANS, nLon*TO_RADIANS)
+			lat = nLat
+			lon = nLon
+		}
+
+		if coordinateMatches(nLat, nLon, targetLat, targetLon) {
+			return distance, true
+		}
+	}
+
+	return 0.0, false
+}
+
+func trafficControlForDirection(way Way, isForward bool) (string, float64, float64) {
+	if isForward {
+		controlType, err := way.TrafficControlForward()
+		if err == nil && controlType != "" {
+			return controlType, way.TrafficControlForwardLat(), way.TrafficControlForwardLon()
+		}
+	} else {
+		controlType, err := way.TrafficControlBackward()
+		if err == nil && controlType != "" {
+			return controlType, way.TrafficControlBackwardLat(), way.TrafficControlBackwardLon()
+		}
+	}
+
+	controlType, err := way.TrafficControl()
+	if err != nil || controlType == "" {
+		return "", 0.0, 0.0
+	}
+	return controlType, way.TrafficControlLat(), way.TrafficControlLon()
+}
+
+func trafficControlForWay(way Way, from Position, fallback Coordinates, baseDistance float64, isForward bool) TrafficControl {
+	controlType, lat, lon := trafficControlForDirection(way, isForward)
+	if controlType == "" {
+		return TrafficControl{}
+	}
+
+	if lat == 0 && lon == 0 {
+		lat = fallback.Latitude()
+		lon = fallback.Longitude()
+	}
+
+	distance, ahead := distanceToTrafficControl(from, way, isForward, lat, lon)
+	if !ahead {
+		return TrafficControl{}
+	}
+	distance += baseDistance
+
+	return TrafficControl{
+		StartLatitude:  lat,
+		StartLongitude: lon,
+		EndLatitude:    lat,
+		EndLongitude:   lon,
+		Type:           controlType,
+		Distance:       distance,
+	}
+}
+
+func calculateNextTrafficControl(state *State) TrafficControl {
+	cumulativeDistance := 0.0
+	if state.CurrentWay.Way.HasNodes() {
+		distToEnd, err := DistanceToEndOfWay(state.Position, state.CurrentWay.Way, state.CurrentWay.OnWay.IsForward)
+		if err == nil && distToEnd > 0 {
+			cumulativeDistance = distToEnd
+		}
+	}
+
+	for _, nextWay := range state.NextWays {
+		from := Position{Latitude: nextWay.StartPosition.Latitude(), Longitude: nextWay.StartPosition.Longitude()}
+		trafficControl := trafficControlForWay(nextWay.Way, from, nextWay.StartPosition, cumulativeDistance, nextWay.IsForward)
+		if trafficControl.Type != "" {
+			return trafficControl
+		}
+
+		if nextWay.Way.HasNodes() {
+			wayDistance, err := calculateWayDistance(nextWay.Way)
+			if err == nil {
+				cumulativeDistance += wayDistance
+			}
+		}
+	}
+
+	return TrafficControl{}
+}
