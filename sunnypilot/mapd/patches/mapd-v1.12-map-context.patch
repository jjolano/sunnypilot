+func roadContextString(context RoadContext) string {
+	switch context {
+	case CONTEXT_FREEWAY:
+		return "freeway"
+	case CONTEXT_CITY:
+		return "city"
+	default:
+		return "unknown"
+	}
+}
+
+func currentRoadContext(state *State) string {
+	if !state.CurrentWay.Way.HasNodes() {
+		return ""
+	}
+	return roadContextString(determineRoadContext(state.CurrentWay.Way, state.Position))
+}
+
+func calculateNextLanes(state *State, currentLanes uint8) NextLanes {
+	cumulativeDistance := 0.0
+	if state.CurrentWay.Way.HasNodes() {
+		distToEnd, err := DistanceToEndOfWay(state.Position, state.CurrentWay.Way, state.CurrentWay.OnWay.IsForward)
+		if err == nil && distToEnd > 0 {
+			cumulativeDistance = distToEnd
+		}
+	}
+
+	for _, nextWay := range state.NextWays {
+		nextLanes := nextWay.Way.Lanes()
+		if nextLanes > 0 && nextLanes != currentLanes {
+			return NextLanes{
+				StartLatitude:  nextWay.StartPosition.Latitude(),
+				StartLongitude: nextWay.StartPosition.Longitude(),
+				EndLatitude:    nextWay.EndPosition.Latitude(),
+				EndLongitude:   nextWay.EndPosition.Longitude(),
+				Lanes:          nextLanes,
+				Distance:       cumulativeDistance,
+			}
+		}
+
+		if nextWay.Way.HasNodes() {
+			wayDistance, err := calculateWayDistance(nextWay.Way)
+			if err == nil {
+				cumulativeDistance += wayDistance
+			}
+		}
+	}
+
+	return NextLanes{}
+}
